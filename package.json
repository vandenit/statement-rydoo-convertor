{
  "name": "statement-convertor",
  "version": "0.2.7",
  "description": "Convert bank statement PDFs to Excel format",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && npm run test",
    "bundle": "node scripts/bundle.js",
    "build:exe": "npm run check && npm run bundle && npx pkg dist/bundle.cjs --targets node18-win-x64 --output ./dist-exe/statement-convertor.exe",
    "build:macos": "npm run check && npm run bundle && npx pkg dist/bundle.cjs --targets node18-macos-x64,node18-macos-arm64 --out-path ./dist-macos",
    "test:binary": "npm run bundle && npx pkg dist/bundle.cjs --targets node18-linux-x64 --output ./dist-linux/test-bin && ./dist-linux/test-bin --help",
    "release": "./scripts/release.sh"
  },
  "bin": {
    "statement-convertor": "./dist/cli.js"
  },
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ]
  },
  "keywords": [
    "pdf",
    "excel",
    "bank",
    "statement",
    "converter"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "pkg": "^5.8.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  }
}
