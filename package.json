{
  "name": "statement-convertor",
  "version": "0.9.1",
  "description": "Convert bank statement PDFs to Excel format",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "bot": "node --loader ts-node/esm src/bot.ts",
    "bot:start": "nohup node --loader ts-node/esm src/bot.ts > bot.log 2>&1 &",
    "bot:stop": "kill $(cat bot.pid) && rm bot.pid",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run src/",
    "test:watch": "vitest src/",
    "check": "tsc --noEmit && npm run test",
    "bundle": "node scripts/bundle.js",
    "build:exe": "npm run check && npm run bundle && npx pkg . --targets node18-win-x64 --output ./dist-exe/statement-convertor.exe",
    "build:macos": "npm run check && npm run bundle && npx pkg . --targets node18-macos-x64,node18-macos-arm64 --out-path ./dist-macos",
    "test:binary": "npm run bundle && npx pkg . --targets node18-linux-x64 --output ./dist-linux/test-bin && ./scripts/test-binary.sh ./dist-linux/test-bin",
    "release": "./scripts/release.sh"
  },
  "bin": {
    "statement-convertor": "./dist/bundle.cjs"
  },
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ]
  },
  "keywords": [
    "pdf",
    "excel",
    "bank",
    "statement",
    "converter"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.4.0",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "pkg": "^5.8.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.4",
    "pdf-parse": "^1.1.1",
    "postmark": "^4.0.7",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.2"
  }
}
